# Copy to testbed/.env and adjust as needed:
#   cp testbed/.env.example testbed/.env
#
# docker compose loads .env from the compose file directory automatically.

# --- Compose / servers ---
MC_VERSION=26.2
PROXY_HOST_PORT=25565
DOCS_HOST_PORT=8080

# Light defaults for local WSL / laptops. Raise only if you have headroom.
HUB_MEMORY=1G
HUB_MEM_LIMIT=1280m
MINIGAME_MEMORY=1G
MINIGAME_MEM_LIMIT=1280m
VELOCITY_MEMORY=256M
PAPER_CPUS=1.5
PAPER_CPU_COUNT=2
VIEW_DISTANCE=4
SIMULATION_DISTANCE=4
MAX_PLAYERS=10

RCON_PASSWORD=nubstack
MARIADB_ROOT_PASSWORD=nubstack
MARIADB_DATABASE=nubstack
MARIADB_USER=nubstack
MARIADB_PASSWORD=nubstack

# Injected into Paper as PAPER_VELOCITY_SECRET. Must match velocity/forwarding.secret.
VELOCITY_FORWARDING_SECRET=nubstack-forwarding-secret

# --- Mineflayer smoke (host: npm run smoke) ---
# Compose --profile bots overrides host/port to velocity:25577 inside the network.
PROXY_HOST=127.0.0.1
PROXY_PORT=25565
BOT_COUNT=3
# Mineflayer protocol pin (server is 26.2; ViaBackwards bridges the gap)
BOT_VERSION=26.1

# --- Not driven by this file ---
# Plugin JDBC / Redis / Discord token live in each plugin's config.yml after first
# boot (defaults use localhost + change-me). Inside Docker they must point at
# mariadb/redis and use MARIADB_* above.
